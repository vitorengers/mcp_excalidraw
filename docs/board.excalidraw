   "isDeleted": false,
   "boundElements": null,
   "updated": 1785079211380,
   "link": null,
   "locked": false,
   "text": "If the port is taken, the new\nprocess fails and the old one\nkeeps answering — silently, with\nthe old code. Kill by PID before\nstarting; the script does it.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "If the port is taken, the new\nprocess fails and the old one\nkeeps answering — silently, with\nthe old code. Kill by PID before\nstarting; the script does it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "ms1ruw6ssbfxvz7omyq",
   "type": "text",
   "x": 383,
   "y": 2371,
   "width": 305.04998779296875,
   "height": 23.75,
   "angle": 0,
   "strokeColor": "#c92a2a",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
