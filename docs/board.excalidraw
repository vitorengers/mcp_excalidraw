   "roundness": null,
   "seed": 1488285992,
   "version": 1,
   "versionNonce": 591317336,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1785079211380,
   "link": null,
   "locked": false,
   "text": "The agent outlives its own issue",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The agent outlives its own issue",
