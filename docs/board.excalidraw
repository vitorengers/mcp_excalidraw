  },
  {
   "id": "ms1ruw6s20f1r8gvdaq",
   "type": "text",
   "x": 1212,
   "y": 428,
   "width": 217.96665954589844,
   "height": 81.25,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "av",
   "roundness": null,
   "seed": 2110715736,
   "version": 1,
   "versionNonce": 179033640,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1785079211380,
   "link": null,
   "locked": false,
   "text": "A Windows portproxy rule maps\n0.0.0.0:3000 to localhost:3000 —\nitself. iphlpsvc answers and the\nconnection dies in the loop.\nHence 3737.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A Windows portproxy rule maps\n0.0.0.0:3000 to localhost:3000 —\nitself. iphlpsvc answers and the\nconnection dies in the loop.\nHence 3737.",
   "autoResize": true,
   "lineHeight": 1.25
  },
