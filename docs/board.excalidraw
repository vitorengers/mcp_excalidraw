   "isDeleted": false,
   "boundElements": null,
   "updated": 1785079211380,
   "link": null,
   "locked": false,
   "text": "A server started before the CLI\nwas installed hands that stale\nPATH to the agent. The server\ninjects the GitHub CLI directory\nwhen it cannot find gh.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A server started before the CLI\nwas installed hands that stale\nPATH to the agent. The server\ninjects the GitHub CLI directory\nwhen it cannot find gh.",
   "autoResize": true,
   "lineHeight": 1.25
  },
