   "index": "ay",
   "roundness": null,
   "seed": 150291752,
   "version": 1,
   "versionNonce": 751842648,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1785079211380,
   "link": null,
   "locked": false,
   "text": "If the port is taken, the new\nprocess fails and the old one\nkeeps answering — silently, with\nthe old code. Kill by PID before\nstarting; running.md has the step.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "If the port is taken, the new\nprocess fails and the old one\nkeeps answering — silently, with\nthe old code. Kill by PID before\nstarting; running.md has the step.",
   "autoResize": true,
   "lineHeight": 1.25
  },
