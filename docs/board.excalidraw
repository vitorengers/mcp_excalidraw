   "link": null,
   "locked": false,
   "text": "#1   sync reconciled by version, not clear-and-replace\n#2   link and customData accepted by the schemas\n#3   documentation panel behind customData.docKey\n#7   workspace registry, one project per board\n#8   per-workspace storage, one tab per project\n#9   shared Excalidraw library\n#10  collapsible image block\n#11  issue block: an observation becomes an issue",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "#1   sync reconciled by version, not clear-and-replace\n#2   link and customData accepted by the schemas\n#3   documentation panel behind customData.docKey\n#7   workspace registry, one project per board\n#8   per-workspace storage, one tab per project\n#9   shared Excalidraw library\n#10  collapsible image block\n#11  issue block: an observation becomes an issue",
   "autoResize": true,
   "lineHeight": 1.25
  },
