   "updated": 1785068817115,
   "link": null,
   "locked": false,
   "text": "A Windows portproxy rule maps\n0.0.0.0:3000 to localhost:3000 —\nitself. iphlpsvc answers and the\nconnection dies in the loop.\nHence 3737.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A Windows portproxy rule maps\n0.0.0.0:3000 to localhost:3000 —\nitself. iphlpsvc answers and the\nconnection dies in the loop.\nHence 3737.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "ms1ruw6s20sznedkq9s",
   "type": "text",
   "x": 858,
   "y": 1108,
   "width": 190.1507568359375,
   "height": 146.25,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "ar",
   "roundness": null,
   "seed": 1530424664,
   "version": 2,
   "versionNonce": 1112522792,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1785068817115,
   "link": null,
   "locked": false,
   "text": "An automated browser test.\n\nThe UI layer is checked by\nhand today, and three real\ndefects — a panel that never\nopened, a race in tab startup,\na click landing on the label —\ncompiled cleanly and still\ndid not work.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "An automated browser test.\n\nThe UI layer is checked by\nhand today, and three real\ndefects — a panel that never\nopened, a race in tab startup,\na click landing on the label —\ncompiled cleanly and still\ndid not work.",
   "autoResize": true,
   "lineHeight": 1.25
  },
