   "versionNonce": 290137136,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1785079211380,
   "link": null,
   "locked": false,
   "text": "A real issue block, not a card about one.\n\nSelect it, then press \"Create issue\" in the panel. An agent\ninvestigates this repository, files the issue with gh, and the\nURL comes back onto the block. It takes minutes, and the\nblock shows \"running\" the whole time.\n\nEdit the text first if you want to file something else.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A real issue block, not a card about one.\n\nSelect it, then press \"Create issue\" in the panel. An agent\ninvestigates this repository, files the issue with gh, and the\nURL comes back onto the block. It takes minutes, and the\nblock shows \"running\" the whole time.\n\nEdit the text first if you want to file something else.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "ms1sv74h3b2tmxfs5o9",
   "type": "text",
   "x": 36.66667175292969,
   "y": 1337.5,
   "width": 486.6666564941406,
   "height": 75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b0E",
   "roundness": null,
   "seed": 246881840,
   "version": 1,
   "versionNonce": 846535888,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1785079211380,
   "link": null,
   "locked": false,
   "text": "The MCP tools and the CLI always write to the default board.\nDriving a registered project board only works over the REST API,\nwhich leaves the MCP server unable to reach the boards this\ntool exists for.",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "ms1ssrytbcwsvbnekqr",
   "originalText": "The MCP tools and the CLI always write to the default board.\nDriving a registered project board only works over the REST API,\nwhich leaves the MCP server unable to reach the boards this\ntool exists for.",
   "autoResize": true,
   "lineHeight": 1.25
  },
