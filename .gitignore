# Dependencies
node_modules/

# Build artifacts
dist/
public/dist/

# Environment files
.env

# The board settings that belong to one machine rather than to the repository — `repo` and
# `githubProject`, which name an account. `board.config.json` is tracked and says what the tool
# is; this says whose checkout it is, and overrides it. See docs/workspaces.md.
board.config.local.json

# Logs
*.log

# Editor artifacts
.cursor/
.claude/
.agent/
.agents/

# Development artifacts. Scratch exports stay out; this project's own board is the
# documentation, so it and the docs it points at are tracked.
*.excalidraw
!docs/board.excalidraw

# Screenshots taken while debugging. They land wherever the tool that took them puts them,
# which is here, and eighteen of them had piled up by #337 — one `git add .` from being a
# commit. Anchored to the root on purpose: an image the documentation points at lives under
# `docs/media/` and an image the frontend imports lives under `frontend/`, and both are files
# somebody chose. This is about the ones nobody did. `demo.gif` is upstream's, and tracked.
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif
!/demo.gif

.DS_Store