# Dependencies
node_modules/

# Build artifacts
dist/
public/dist/

# Environment files
.env

# The board settings that belong to one machine rather than to the repository — `repo` and
# `githubProject`, which name an account. `board.config.json` is tracked and says what the tool
# is; this says whose checkout it is, and overrides it. See docs/workspaces.md.
board.config.local.json

# Logs
*.log

# Editor artifacts
.cursor/
.claude/
.agent/
.agents/

# Development artifacts. Scratch exports stay out; this project's own board is the
# documentation, so it and the docs it points at are tracked.
*.excalidraw
!docs/board.excalidraw

.DS_Store